# Frontend Environment Variables
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# Backend Environment Variables
NODE_ENV=production
PORT=5005
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/atomquest?retryWrites=true&w=majority

# JWT Configurations
JWT_SECRET=your_super_secret_production_key_here
JWT_EXPIRES_IN=24h
